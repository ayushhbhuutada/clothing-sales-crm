# Backend Environment Configuration
PORT=5000
NODE_ENV=production

# Optional: random secret (32+ chars) used to sign staff login tokens. If not set, the server
# generates one on first start and stores it in the database (app_settings table).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated frontend origins allowed to call the API (only needed when the
# frontend is hosted separately, e.g. on Vercel). Leave blank for single-service deploys.
CORS_ORIGIN=https://your-frontend.vercel.app

# Number of reverse-proxy hops in front of the server (defaults to 1 in production)
# TRUST_PROXY=1
